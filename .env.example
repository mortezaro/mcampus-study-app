NODE_ENV=production
PORT=4173
HOST=0.0.0.0

# Public study URL after deployment, for logs/config display.
APP_BASE_URL=https://your-study-domain.example

# Replace with the real Prolific completion URL/code before launch.
PROLIFIC_COMPLETION_URL=https://app.prolific.co/submissions/complete?cc=REAL_CODE

# Required in production for /api/admin/events.
ADMIN_TOKEN=replace-with-a-long-random-secret

# Audio upload cap per recording request.
MAX_UPLOAD_MB=25

# Optional: set this to a mounted persistent disk/volume path on Render/Railway/Fly.
DATA_DIR=/data
