NODE_ENV=production
PORT=4173
HOST=0.0.0.0

# Public study URL after deployment, for logs/config display.
APP_BASE_URL=https://your-study-domain.example

# Replace with the real Prolific completion URL/code before launch.
PROLIFIC_COMPLETION_URL=https://app.prolific.co/submissions/complete?cc=REAL_CODE

# Optional: Prolific study ID for the onboarding wave.
ONBOARDING_STUDY_ID=your_onboarding_study_id

# Optional: map each Prolific wave study ID to onboarding, the main longitudinal entry, or a specific EMA day/slot.
# Example:
# PROLIFIC_WAVE_MAP_JSON={"project_a_onboarding_id":{"kind":"onboarding","title":"Onboarding"},"project_a_main_id":{"kind":"main","title":"Main longitudinal study"},"project_b_day1_morning":{"kind":"ema","day":1,"slot":1,"label":"Morning"}}
PROLIFIC_WAVE_MAP_JSON={}

# Required in production for /api/admin/events.
ADMIN_TOKEN=replace-with-a-long-random-secret

# Optional reminder delivery providers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Audio upload cap per recording request.
MAX_UPLOAD_MB=25

# Optional: set this to a mounted persistent disk/volume path on Render/Railway/Fly.
DATA_DIR=/data
